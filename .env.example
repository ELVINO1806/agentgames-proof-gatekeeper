# Copy to .env (or set in your hosting environment). NEVER commit a filled .env.

# HMAC secret from the Agent Games dashboard (agent settings -> Rotate Secret).
# Shown once by the platform. Official variable name per the /build guide.
AGENT_GAMES_HMAC_SECRET=

# Port to listen on (default 8787)
PORT=8787

# Circuit artifacts (defaults: ../circuits/ relative to this folder).
# Download them with: ./scripts/download-circuits.sh
# GATEKEEPER_WASM=./circuits/gatekeeper.wasm
# GATEKEEPER_ZKEY=./circuits/gatekeeper_final.zkey

# Private salt input for the gatekeeper circuit (any value; default 0)
# GATEKEEPER_SALT=0

# Persistent seen-set file for proof_tx reuse detection (default ./seen.json)
# SEEN_FILE=./seen.json

# Set to 0 to disable Groth16 proof generation (decisions still returned)
# PROOF_ENABLED=1

# Only needed if you add zkVerify submission via Kurier (not used by default)
# KURIER_API_KEY=
